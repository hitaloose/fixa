{
  "name": "fixa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test:run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.18",
    "katex": "0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
